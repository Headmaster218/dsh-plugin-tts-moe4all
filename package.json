{
  "name": "dsh-plugin-tts-moe4all",
  "description": "MoE4All 版 Edge TTS 插件：消息朗读按钮、自动朗读开关和语音设置面板",
  "version": "0.3.1-moe4all.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": ">=0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-base": ">=0.1.0-rc.6"
  },
  "scripts": {
    "test": "node tests/smoke.mjs",
    "test:live": "node tests/rvc-server-live.mjs",
    "test:patch": "node tests/package-runtime-patch.mjs",
    "test:i18n": "node tests/i18n-keys.mjs",
    "test:client": "node tests/client-load.mjs",
    "test:all": "node tests/smoke.mjs && node tests/rvc-server-live.mjs && node tests/package-runtime-patch.mjs && node tests/i18n-keys.mjs && node tests/client-load.mjs",
    "ci:check": "node --experimental-vm-modules ci/plugin-ci.mjs check",
    "ci:test": "node ci/plugin-ci.mjs test",
    "ci:contract": "node ci/plugin-ci.mjs test-contract",
    "release:build": "node --experimental-vm-modules ci/plugin-ci.mjs pack",
    "release:verify": "node ci/plugin-ci.mjs verify-release"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Headmaster218/dsh-plugin-tts-moe4all.git"
  },
  "homepage": "https://github.com/Headmaster218/dsh-plugin-tts-moe4all#readme",
  "bugs": {
    "url": "https://github.com/Headmaster218/dsh-plugin-tts-moe4all/issues"
  },
  "moe4all": {
    "upstream": "@dsh-external/dsh-plugin-tts@0.3.1",
    "repository": "https://github.com/1624318455/dsh-plugin-tts",
    "commit": "3f362452cbf0c52ef5781bb312df0512df9b578f"
  },
  "packageManager": "npm@10.9.2",
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ]
}
